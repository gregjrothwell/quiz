{
  "name": "quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://gregjrothwell.github.io/quiz/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore,database",
    "e2e": "firebase emulators:exec --only auth,firestore,database --project quiz-d686e \"npx playwright test\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fetch-questions": "tsx scripts/fetch-questions.ts",
    "fetch-otqa": "tsx scripts/opentriviaqa.ts",
    "check-rules": "tsx --env-file=.env.local scripts/check-rules.ts",
    "appcheck-probe": "tsx --env-file=.env.local scripts/appcheck-probe.ts",
    "seed-vault": "tsx --env-file=.env.local scripts/seed-vault.ts",
    "write-hand-packs": "tsx scripts/write-hand-packs.ts",
    "write-melody-pack": "tsx scripts/write-melody-pack.ts",
    "write-tunes-pack": "tsx scripts/write-tunes-pack.ts",
    "write-flags-pack": "tsx scripts/write-flags-pack.ts",
    "write-sleeves-pack": "tsx scripts/write-sleeves-pack.ts",
    "write-screens-pack": "tsx --env-file=.env.local scripts/write-screens-pack.ts",
    "itunes-probe": "tsx scripts/itunes-probe.ts",
    "tune-audit": "tsx scripts/tune-title-audit.ts",
    "tmdb-probe": "tsx --env-file=.env.local scripts/tmdb-probe.ts",
    "fold-votes": "tsx --env-file=.env.local scripts/fold-votes.ts",
    "read-games": "tsx --env-file=.env.local scripts/read-games.ts",
    "sync-harness": "tsx --env-file=.env.local scripts/sync-harness.ts",
    "host-room": "tsx --env-file=.env.local scripts/host-room.ts",
    "rank-harness": "tsx --env-file=.env.local scripts/rank-harness.ts",
    "check-bundle": "tsx scripts/check-bundle.ts",
    "predeploy-ref": "tsx scripts/predeploy.ts",
    "deploy": "npm run predeploy-ref && npm run build && npm run check-bundle && gh-pages -d dist",
    "take-stock": "tsx --env-file=.env.local scripts/take-stock.ts",
    "prune-rooms": "tsx --env-file=.env.local scripts/prune-rooms.ts",
    "reveal-probe": "tsx --env-file=.env.local scripts/reveal-gate-probe.ts",
    "asked-probe": "tsx --env-file=.env.local scripts/asked-probe.ts",
    "backfill-form": "tsx --env-file=.env.local scripts/backfill-form.ts"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "motion": "^11.15.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.30.0",
    "gh-pages": "^6.2.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

rules_version = '2';

// The quizmaster is derived, not stored: it is whoever has been in the room
// longest. Rules cannot compute that cheaply, so they enforce the weaker but
// sufficient invariant that every writer must be a signed-in member of the room.
// The engine enforces game legality; these rules stop outsiders touching a room,
// bound what a member can write, and stop anyone editing someone else's answer.
//
// **The room code is the capability.** Anyone holding a code can read the room,
// and has to be able to — joining reads the document before writing to it. That
// only holds up while a code has to be read out rather than harvested, which is
// why `list` is deliberately absent below.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── The vault ───────────────────────────────────────────────────────────
    //
    // Every question's answer, and not one word of it is readable by anybody.
    // `allow read: if false` is absolute for clients — but *rules* can still
    // see it, because `get()` inside a rule is not subject to the rules on the
    // document it reads. That asymmetry is the entire mechanism: no device can
    // look an answer up, and the reveal rule below can still check one.
    //
    // Seeded once from `.cache/vault.json` by `npm run seed-vault`, which needs
    // firestore.seed.rules published for as long as it runs. `npm run
    // check-rules` fails loudly if the seeding ruleset is still live.
    match /vault/{questionId} {
      allow read, write: if false;
    }

    // ── Identity ──────────────────────────────────────────────────────────────
    //
    // A season row used to be keyed on the auth uid. That uid dies with site
    // storage — iOS Safari evicts after about a week — and a second machine has
    // never seen it. So a row is keyed on a **playerId** which *defaults to the
    // uid*: every row written before this still validates, with no migration,
    // and a player who claims nothing is on exactly the path they were on.
    //
    // Whether a writer holds a playerId is the one question these rules have to
    // answer, and `ownsPlayer` is the whole of it. The uid case is deliberately
    // first: rules short-circuit, so the ordinary unclaimed player costs no
    // extra document read at all, and only somebody who has claimed pays one —
    // once per game, when their row is banked.
    //
    // `exists()` before `get()` is load-bearing. A `get()` on a missing document
    // returns null, and reading `.data` off null errors the rule, which denies —
    // so without it a browser that had never claimed anything would be locked
    // out of its own row. Both calls read the same document inside one
    // evaluation and Firestore caches that, so the pair still costs one read.
    function ownsPlayer(playerId) {
      return request.auth != null
        && (playerId == request.auth.uid
            || (exists(/databases/$(database)/documents/claims/$(request.auth.uid))
                && get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.playerId
                     == playerId));
    }

    // What a recovery code points at. **The code is the secret, so the document
    // id is the proof** — which is why this is readable and the vault is not.
    // The vault's ids ship inside the packs, so an answer had to be unreadable
    // and merely checkable; a recovery code is known only to whoever was given
    // it. `list` is denied for the same reason it is denied on rooms: a
    // capability you can enumerate is not one. 29^8 is about 5×10^11.
    //
    // Minting is restricted to an identity the writer already holds. Without
    // that, anybody could read a playerId off the season table — they are the
    // document ids of a readable collection — mint a code pointing at it, claim
    // it, and write that person's row.
    match /recovery/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerId.size() <= 128
        && ownsPlayer(request.resource.data.playerId);

      // Never repointed: an update would let whoever minted a code aim it at
      // somebody else's identity after the fact, which is the one move that
      // turns a capability into a theft.
      allow update: if false;

      // Revocable by whoever it belongs to, which is how a leaked code is
      // killed. It strands nobody: a browser that has already claimed carries
      // its own `claims` document, and the season rules read *that* — this is
      // only consulted when a claim is made. So deleting stops the code being
      // used again and leaves everyone who already used it exactly where they
      // are, which is precisely what revoking should mean.
      allow delete: if ownsPlayer(resource.data.playerId);
    }

    // Which identity a browser has taken on. Read by the rules above on every
    // season write, and by nobody else — it is this browser's business.
    //
    // A claim is only accepted against a live recovery document naming the same
    // playerId, so the assertion cannot be made up. Updating is allowed, with
    // the identical check, so a browser can move between identities rather than
    // being pinned to the first one it ever claimed; deleting returns it to its
    // own uid, which is the way back out.
    match /claims/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['playerId', 'code'])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerId.size() <= 128
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/recovery/$(request.resource.data.code))
        && get(/databases/$(database)/documents/recovery/$(request.resource.data.code)).data.playerId
             == request.resource.data.playerId;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /rooms/{code} {
      // Comfortably past an office round, tight enough that a malformed write
      // cannot inflate the document every client re-reads on every transition.
      function maxPlayers() { return 60; }
      function maxQuestions() { return 50; }

      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn()
          && resource.data.players.keys().hasAny([request.auth.uid]);
      }

      // `joinedAt` is `Date.now()`. Checked as `is number` rather than `is int`
      // on purpose: the exact wire type is the SDK's choice, and a room nobody
      // can join is a far worse failure than a float slipping past a bound that
      // exists only to keep garbage out.
      //
      // **`playerId` is optional and nothing writes it yet.** It is accepted
      // here because the pre-round title card will want to know who is in the
      // room without paying a `claims` read per player, and the room document is
      // already re-read on every transition — but the client half belongs with
      // that feature. Bounded now because this is the republish that is
      // happening; a second hand-paste is the thing worth avoiding, not a field
      // sitting unused. An unwritten field is inert.
      //
      // It also means publishing these rules ahead of the bundle changes nothing
      // for anybody already playing: every entry in the wild is `{name,
      // joinedAt}`, which still validates exactly as it did.
      function playerOk(player) {
        return player.keys().hasOnly(['name', 'joinedAt', 'playerId'])
          && player.name is string
          && player.name.size() > 0
          && player.name.size() <= 40
          && player.joinedAt is number
          && player.get('playerId', '') is string
          && player.get('playerId', '').size() <= 128;
      }

      // The writer's own entry is the only one a rule can check without
      // iterating the map, which rules cannot do. A member can still write a
      // neighbour's entry — see the `update` rule.
      function ownEntryOk() {
        return !request.resource.data.players.keys().hasAny([request.auth.uid])
          || playerOk(request.resource.data.players[request.auth.uid]);
      }

      // Invariants every write preserves, so no member can leave the room in a
      // state the client cannot render or the free tier cannot afford. The phase
      // list matters: App.tsx matches phases exhaustively, so an unrecognised one
      // renders an empty screen for everybody in the room.
      // Whether this write is what puts a new question in front of the room, as
      // opposed to any other write while one happens to be open — a player
      // joining mid-question is also an update with `phase: 'question'`.
      function opensAQuestion() {
        return request.resource.data.phase == 'question'
          && (resource.data.phase != 'question'
              || resource.data.index != request.resource.data.index);
      }

      // The answer window, in seconds. Chosen in the lobby, and read by the
      // reveal rule below rather than hardcoded there, so a ten-second round
      // does not sit through a twenty-second gate.
      //
      // Bounds, not the lobby's own three options, and the floor is the point.
      // Any member can restart a question — write the room to a non-question
      // phase and back again and `openedAt` is restamped — which was harmless
      // while the gate was a fixed twenty seconds, because restarting could only
      // ever push the vault further away. A window that is read from the
      // document turns that same move into a way to pull the gate *closer*, so
      // what stops it being a silent cheat is that it cannot go below five
      // seconds and cannot happen without the whole room watching the timer
      // jump. Vandalism, and loud.
      function minDuration() { return 5; }
      function maxDuration() { return 120; }

      // `is number`, not `is int`, for the same reason as `joinedAt` above: the
      // wire type is the SDK's choice, and a round that cannot be revealed is a
      // far worse failure than a float slipping past a bound. The reveal rule
      // multiplies this out in milliseconds rather than handing it to
      // `duration.value`, which takes an int and would reject a double outright
      // — denying every reveal in the room and stopping the round dead.
      function durationOk() {
        return request.resource.data.get('durationSecs', 20) is number
          && request.resource.data.get('durationSecs', 20) >= minDuration()
          && request.resource.data.get('durationSecs', 20) <= maxDuration();
      }

      // `openedAt` is the server's own record of when the current question went
      // live, and the vault's time gate is measured from it. Opening a question
      // must stamp it with `request.time` — which only `serverTimestamp()`
      // satisfies — and every other write must leave it exactly as it was.
      //
      // Without the second half, a member could hold a question open, rewrite
      // `openedAt` into the past, and unlock the answer while the clock was
      // still running. `get` with a default covers a room created before these
      // fields existed, and a lobby that has never had a question at all.
      //
      // The window is pinned by the same rule and for a sharper reason. If a
      // member could lower `durationSecs` while a question was open, they would
      // open the vault early while everybody else still believed they had the
      // time the timer was showing them — a silent cheat, which is the exact
      // class the vault exists to kill. Both fields therefore move only on the
      // write that opens a question, so the worst that remains is choosing a
      // short window *before* the round starts, which everyone can see.
      function timingOk() {
        return opensAQuestion()
          ? request.resource.data.openedAt == request.time
          : request.resource.data.get('openedAt', null) == resource.data.get('openedAt', null)
            && request.resource.data.get('durationSecs', 20)
                 == resource.data.get('durationSecs', 20);
      }

      function wellFormed() {
        return request.resource.data.code == code
          && request.resource.data.phase in
               ['lobby', 'question', 'reveal', 'scoreboard', 'finished']
          && request.resource.data.players.keys().size() <= maxPlayers()
          && request.resource.data.scores.keys().size() <= maxPlayers()
          && request.resource.data.questions.size() <= maxQuestions()
          && durationOk()
          && ownEntryOk();
      }

      // Anyone signed in can look up a room in order to join it.
      //
      // `list` is not granted. The app never queries the collection, so allowing
      // it costs nothing to drop and would otherwise let any anonymous visitor
      // enumerate every live room — its players, its scores, its questions and
      // every `correctIndex` — and write to all of them. A four-character code is
      // only a reasonable secret while it cannot be harvested in one query.
      allow get: if signedIn();

      // Creating a room means putting yourself in it as the only player, in a
      // lobby with no questions yet.
      allow create: if signedIn()
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        // `hasOnly` is satisfied by the empty map, which would mint a room with
        // no members and so no derivable quizmaster.
        && request.resource.data.players.keys().size() == 1
        && request.resource.data.phase == 'lobby'
        && request.resource.data.questions.size() == 0
        && wellFormed();

      // Members drive the game. Joining is also an update, so allow a writer who
      // is a member either before or after the write.
      //
      // A member can still overwrite the phase, the scores, the questions and
      // other players: the quizmaster is derived rather than stored, so there is
      // no uid here to compare against. That is accepted for a room of colleagues
      // and written down in docs/HANDOVER.md. `wellFormed` is what keeps the
      // worst case to mischief rather than an unplayable or expensive room.
      allow update: if signedIn()
        && (isMember() || request.resource.data.players.keys().hasAny([request.auth.uid]))
        && wellFormed()
        && timingOk();

      // Rooms are disposable; nobody needs to delete one mid-quiz.
      allow delete: if false;

      match /answers/{uid} {
        // Everyone in the room reads answers so the reveal can render.
        //
        // Restricting this to members would cost a document read per rule
        // evaluation — on a listener, per snapshot — and buy almost nothing:
        // reaching this path needs the room code, and anyone with the code can
        // simply join. Members seeing each other's answers before the reveal is
        // inherent without server-side logic, and is accepted rather than fixed.
        allow read: if signedIn();

        // You may only write your own answer, and only with a sane shape.
        // `elapsedMs` is measured on the answering device and cannot be checked
        // here; the bounds keep nonsense out of the document, they are not an
        // anti-cheat. See docs/HANDOVER.md.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['optionIndex', 'elapsedMs', 'questionIndex'])
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < 10
          && request.resource.data.elapsedMs is int
          && request.resource.data.elapsedMs >= 0
          && request.resource.data.elapsedMs <= 600000
          && request.resource.data.questionIndex is int
          && request.resource.data.questionIndex >= 0
          && request.resource.data.questionIndex < 100;

        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // ── The reveal ────────────────────────────────────────────────────────
      //
      // How the answer gets out of the vault, and the only way it ever does.
      //
      // Nobody can read the vault, so nobody can look an answer up. What they
      // can do is *assert* one — write `{ answer: "Metropolitan Line" }` here —
      // and this rule judges it against the vault. Trying all four options
      // finds the answer in four attempts, which would be a fine way to cheat
      // if the same rule did not refuse every one of them until:
      //
      //   1. the question named in the path is the one actually in play, and
      //   2. the server itself has seen the room's answer window pass since it
      //      opened.
      //
      // The first stops a member holding question one open and quietly asking
      // about the other fourteen. The second means nobody — in this room or in
      // a decoy of their own — can ask before the answering window has already
      // closed, because `openedAt` can only be written as `request.time` and
      // `durationSecs` cannot move while a question is open.
      //
      // What this does not stop is written down in docs/HANDOVER.md. The short
      // version: the questions come from a public database, so a determined
      // attacker was always going to win. This kills the ten-second one.
      match /reveal/{questionId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }

        // Both calls read the same document, and Firestore caches identical
        // document accesses within one rule evaluation, so this costs one read.
        //
        // Compared in milliseconds rather than with `duration.value`, which
        // takes an int: `durationSecs` arrives from a client SDK that decides
        // for itself whether a whole number goes on the wire as an integer or a
        // double, and handing it a double would error the rule and deny every
        // reveal in the room. Plain arithmetic does not care which it got.
        //
        // The default keeps rooms that were already in flight when this shipped
        // working on the twenty seconds their clients still expect.
        function windowClosed() {
          return room().openedAt is timestamp
            && request.time.toMillis()
                 > room().openedAt.toMillis() + room().get('durationSecs', 20) * 1000;
        }

        function isTheQuestionInPlay() {
          return room().questions.size() > room().index
            && room().questions[room().index].id == questionId;
        }

        // Everyone reads the reveal, so a client that missed the room update
        // can still find out what the answer was.
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['answer'])
          && request.resource.data.answer is string
          && isTheQuestionInPlay()
          && windowClosed()
          && request.resource.data.answer
               == get(/databases/$(database)/documents/vault/$(questionId)).data.a;

        // Never rewritten: a settled reveal must not change under the room's
        // feet, and an answer that was true when it was written stays true.
        allow update: if false;

        // Deleting one is allowed, and buys nothing. Re-running the four-way
        // guess afterwards is subject to the same gate as the first time, so it
        // cannot uncover anything earlier than it already could. What it costs
        // is that a member can wipe a reveal mid-round out of mischief — the
        // same class of nuisance as rewriting the phase, which the quizmaster
        // being derived rather than stored already permits. In exchange the
        // preflight can exercise this path on every run instead of once ever.
        allow delete: if signedIn();
      }
    }

    // Season standings. Unlike room scores, these can be locked down properly:
    // a player writes only their own row, so the rules enforce exactly the
    // invariant the app relies on. The values themselves are still self-
    // reported — nothing here stops someone inflating their own total, which is
    // the same trust model as the rest of the game. The bounds below only keep
    // a self-report within the range a real season could produce, so one edited
    // row cannot make the whole table meaningless.
    // What each pack has already served this season, so a round can prefer
    // questions nobody has seen. Not secret — it is a list of ids, and the
    // answers are in the vault — but it is worth bounding, because every client
    // starting a round writes it and an unbounded array on a document read at
    // the top of every game is exactly the shape this project keeps avoiding.
    match /seasons/{season}/asked/{packId} {
      function signedIn() {
        return request.auth != null;
      }

      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['ids', 'at'])
        && request.resource.data.ids is list
        // Matches ASKED_LIMIT in src/lib/season.ts, with room to spare so a
        // client one deploy behind is not locked out of writing its history.
        && request.resource.data.ids.size() <= 600
        && request.resource.data.at is number;

      // Clearing a pack's history is the only way to start it fresh without a
      // new season, and it costs nothing worse than some repeated questions.
      allow delete: if signedIn();
    }

    match /seasons/{season}/players/{playerId} {
      // A round is at most 25 questions at 1,000 points, so 100k leaves room for
      // a long season's best game and still rejects a fantasy number.
      function maxBest() { return 100000; }
      function maxPoints() { return 100000000; }
      function maxPlayed() { return 10000; }

      function signedIn() {
        return request.auth != null;
      }

      // The whole table is readable by any signed-in visitor, which anonymous
      // auth makes effectively public. It holds display names and scores only,
      // and a shared leaderboard has to be shared — but it is a deliberate
      // choice, not an oversight. See docs/HANDOVER.md.
      allow read: if signedIn();

      // Four rosettes, so a shelf cannot hold more of any one of them than there
      // were rounds to win it in. Defaulted rather than required: a row written
      // before honours existed carries none, and a client one deploy behind
      // writes none, and neither should be locked out of its own row.
      function honourOk(field) {
        return request.resource.data.get(field, 0) is int
          && request.resource.data.get(field, 0) >= 0
          && request.resource.data.get(field, 0) <= request.resource.data.played;
      }

      allow create, update: if signedIn()
        && ownsPlayer(playerId)
        && request.resource.data.keys().hasOnly(
             ['name', 'played', 'wins', 'points', 'best', 'lastGame', 'lastPlayed',
              'fastest', 'comeback', 'loneWolf', 'contrarian', 'team'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.played is int
        && request.resource.data.played >= 0
        && request.resource.data.played <= maxPlayed()
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        // You cannot have won more rounds than you played, or scored more in one
        // game than you have scored in total.
        && request.resource.data.wins <= request.resource.data.played
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= maxPoints()
        && request.resource.data.best is int
        && request.resource.data.best >= 0
        && request.resource.data.best <= maxBest()
        && request.resource.data.best <= request.resource.data.points
        && request.resource.data.lastGame is string
        && request.resource.data.lastGame.size() <= 64
        && request.resource.data.lastPlayed is number
        // After `played` has been checked, because that is what they are bounded
        // against and rules evaluate left to right.
        && honourOk('fastest')
        && honourOk('comeback')
        && honourOk('loneWolf')
        && honourOk('contrarian')
        // Nothing writes `team` yet. It is bounded here because the season row
        // is validated with `hasOnly`, so *any* new field on it costs a rules
        // republish — and a hand-pasted ruleset has broken the game twice. A
        // field nobody writes is inert; a republish is not. Whenever team
        // leagues do ship, they are then a client-only change.
        && request.resource.data.get('team', '') is string
        && request.resource.data.get('team', '').size() <= 40;

      // Removing your own row is the only way anybody can take a display name
      // back off a shared board without console access. Someone else's row still
      // needs the console — the app has no moderator.
      allow delete: if signedIn() && ownsPlayer(playerId);
    }
  }
}

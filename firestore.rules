rules_version = '2';

// Published by CI: the `rules` job in .github/workflows/ci.yml, on `master`,
// after e2e has run this file in the emulator and before the site goes out.
// Do not paste it into the console; the next merge replaces whatever is there.
// docs/decisions/rules-from-ci.md.
//
// Since W3 (host authority) a room names its host in `hostUid`, and only the
// host moves the game on. A room made before W3 derives its quizmaster from
// who has been there longest, and there the rules enforce the weaker invariant
// that every writer must be a signed-in member of the room.
// The engine enforces game legality; these rules stop outsiders touching a room,
// bound what a member can write, and stop anyone editing someone else's answer.
//
// **The room code is the capability.** Anyone holding a code can read the room,
// and has to be able to — joining reads the document before writing to it. That
// only holds up while a code has to be read out rather than harvested, which is
// why `list` is deliberately absent below.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── The vault ───────────────────────────────────────────────────────────
    //
    // Every question's answer, and not one word of it is readable by anybody.
    // `allow read: if false` is absolute for clients — but *rules* can still
    // see it, because `get()` inside a rule is not subject to the rules on the
    // document it reads. That asymmetry is the entire mechanism: no device can
    // look an answer up, and the reveal rule below can still check one.
    //
    // Seeded once from `.cache/vault.json` by `npm run seed-vault`, which needs
    // firestore.seed.rules published for as long as it runs. `npm run
    // check-rules` fails loudly if the seeding ruleset is still live.
    match /vault/{questionId} {
      allow read, write: if false;
    }

    // ── Identity ──────────────────────────────────────────────────────────────
    //
    // A season row used to be keyed on the auth uid. That uid dies with site
    // storage — iOS Safari evicts after about a week — and a second machine has
    // never seen it. So a row is keyed on a **playerId** which *defaults to the
    // uid*: every row written before this still validates, with no migration,
    // and a player who claims nothing is on exactly the path they were on.
    //
    // Whether a writer holds a playerId is the one question these rules have to
    // answer, and `ownsPlayer` is the whole of it. The uid case is deliberately
    // first: rules short-circuit, so the ordinary unclaimed player costs no
    // extra document read at all, and only somebody who has claimed pays one —
    // once per game, when their row is banked.
    //
    // `exists()` before `get()` is load-bearing. A `get()` on a missing document
    // returns null, and reading `.data` off null errors the rule, which denies —
    // so without it a browser that had never claimed anything would be locked
    // out of its own row. Both calls read the same document inside one
    // evaluation and Firestore caches that, so the pair still costs one read.
    function ownsPlayer(playerId) {
      return request.auth != null
        && (playerId == request.auth.uid
            || (exists(/databases/$(database)/documents/claims/$(request.auth.uid))
                && get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.playerId
                     == playerId));
    }

    // What a recovery code points at. **The code is the secret, so the document
    // id is the proof** — which is why this is readable and the vault is not.
    // The vault's ids ship inside the packs, so an answer had to be unreadable
    // and merely checkable; a recovery code is known only to whoever was given
    // it. `list` is denied for the same reason it is denied on rooms: a
    // capability you can enumerate is not one. 29^8 is about 5×10^11.
    //
    // Minting is restricted to an identity the writer already holds. Without
    // that, anybody could read a playerId off the season table — they are the
    // document ids of a readable collection — mint a code pointing at it, claim
    // it, and write that person's row.
    match /recovery/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerId.size() <= 128
        && ownsPlayer(request.resource.data.playerId);

      // Never repointed: an update would let whoever minted a code aim it at
      // somebody else's identity after the fact, which is the one move that
      // turns a capability into a theft.
      allow update: if false;

      // Revocable by whoever it belongs to, which is how a leaked code is
      // killed. It strands nobody: a browser that has already claimed carries
      // its own `claims` document, and the season rules read *that* — this is
      // only consulted when a claim is made. So deleting stops the code being
      // used again and leaves everyone who already used it exactly where they
      // are, which is precisely what revoking should mean.
      // **Correction, 22 October 2026:** so it evicts nobody either. Whoever
      // claimed a leaked code before it was deleted keeps writing the row,
      // through their own `claims` document, until that is deleted with the
      // Admin SDK. docs/decisions/identity.md.
      allow delete: if ownsPlayer(resource.data.playerId);
    }

    // Which identity a browser has taken on. Read by the rules above on every
    // season write, and by nobody else — it is this browser's business.
    //
    // A claim is only accepted against a live recovery document naming the same
    // playerId, so the assertion cannot be made up. Updating is allowed, with
    // the identical check, so a browser can move between identities rather than
    // being pinned to the first one it ever claimed; deleting returns it to its
    // own uid, which is the way back out.
    match /claims/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['playerId', 'code'])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerId.size() <= 128
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/recovery/$(request.resource.data.code))
        && get(/databases/$(database)/documents/recovery/$(request.resource.data.code)).data.playerId
             == request.resource.data.playerId;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /rooms/{code} {
      // Comfortably past an office round, tight enough that a malformed write
      // cannot inflate the document every client re-reads on every transition.
      function maxPlayers() { return 60; }
      function maxQuestions() { return 50; }

      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn()
          && resource.data.players.keys().hasAny([request.auth.uid]);
      }

      // `joinedAt` is `Date.now()`. Checked as `is number` rather than `is int`
      // on purpose: the exact wire type is the SDK's choice, and a room nobody
      // can join is a far worse failure than a float slipping past a bound that
      // exists only to keep garbage out.
      //
      // **`playerId` is optional, and it now ships.** It was bounded here ahead
      // of its client so that durable identity could land without a second
      // hand-paste, and `writeSelfIntoRoom` has since started writing it — but
      // only when it differs from the uid, which needs a claimed recovery code.
      // So most entries in the wild are still `{name, joinedAt}` and validate
      // exactly as they always did.
      //
      // The title card is why it is here: it needs to know who is in the room
      // without paying a `claims` read per player, and the room document is
      // already re-read on every transition.
      //
      // **`squad` is the newest of them, and the live squad board is why.** It
      // is the side this player's points count for tonight, which is a Lurker's
      // pick where they made one — a value that exists nowhere but the device
      // that chose it, so it cannot be read off the season record. Bounded to
      // the same 40 characters as the season row's `team`, and optional, so
      // every entry already in the wild still validates.
      function playerOk(player) {
        return player.keys().hasOnly(['name', 'joinedAt', 'playerId', 'squad'])
          && player.name is string
          && player.name.size() > 0
          && player.name.size() <= 40
          && player.joinedAt is number
          && player.get('playerId', '') is string
          && player.get('playerId', '').size() <= 128
          && player.get('squad', '') is string
          && player.get('squad', '').size() <= 40;
      }

      // `joinedAt` decides the quizmaster (`resolveQuizmaster` takes the
      // lowest). A bare `is number` meant `players.<myuid>.joinedAt: 0`
      // seized the role — every phase transition, every reveal, every
      // `scores.*` write. New entries must be within five minutes of the
      // server's clock; existing ones must not move. The window also
      // refuses the accidental stale timestamp from another room (6JA5).
      //
      // A reaped player restored after more than five minutes is a *new*
      // entry carrying the old value, and is refused. Reap is lobby-only.
      // Widening the window reopens the steal; see
      // docs/decisions/security-round-sept-2026.md.
      function joinedAtGraceMs() { return 300000; }

      function newJoinedAtOk() {
        return request.resource.data.players.keys().hasAny([request.auth.uid])
          && request.resource.data.players[request.auth.uid].joinedAt
               >= request.time.toMillis() - joinedAtGraceMs()
          && request.resource.data.players[request.auth.uid].joinedAt
               <= request.time.toMillis() + joinedAtGraceMs();
      }

      function ownJoinedAtOk() {
        return !request.resource.data.players.keys().hasAny([request.auth.uid])
          || (resource.data.players.keys().hasAny([request.auth.uid])
                ? request.resource.data.players[request.auth.uid].joinedAt
                    == resource.data.players[request.auth.uid].joinedAt
                : newJoinedAtOk());
      }

      // The reveal gate asks the room which question is in play, so a room
      // that can rewrite its own question list can ask about anything in
      // the vault.
      //
      // **`selectPack` and `reset` are not the only writers.** The first cut
      // of this rule said they were, pinned the list byte for byte, and so
      // refused the reveal — which stamps the resolved answer into
      // `questions[index].correctIndex`, so every other client reads it off
      // the room update it is already listening to rather than paying for its
      // own vault round trip (`reveal` in src/engine/reducer.ts). Every round
      // in the project stopped dead on its first question. 22 September 2026;
      // see docs/decisions/security-round-sept-2026.md.
      //
      // So the question in play may change, and nothing else about the list
      // may: not its id, not `index` on the same write, not any other entry.
      // That is still the whole of what closes the oracle. Substituting into
      // another slot is refused outright, so the two-write version — edit slot
      // 1, then move `index` onto it — dies on the first write; and
      // substituting into this slot cannot change the id, which is the only
      // thing `isTheQuestionInPlay()` reads. Options may move and buy nothing:
      // the reveal document still has to carry the vault's own answer string.
      //
      // Deliberately not narrowed to the `question` → `reveal` transition. The
      // property holds at any phase, and a rule that refuses a reveal written
      // from an unexpected phase is the failure this comment exists about.
      function onlyTheQuestionInPlayMoved() {
        return request.resource.data.index == resource.data.index
          && resource.data.index < resource.data.questions.size()
          && request.resource.data.index < request.resource.data.questions.size()
          && request.resource.data.questions[request.resource.data.index].id
               == resource.data.questions[resource.data.index].id
          // Everything but the question in play, on both sides. `removeAll`
          // strips every element equal to the one given, so a write that made
          // some other entry a duplicate of this one leaves the two lists
          // different sizes and is refused — the safe direction.
          && request.resource.data.questions
               .removeAll([request.resource.data.questions[request.resource.data.index]])
             == resource.data.questions
               .removeAll([resource.data.questions[resource.data.index]]);
      }

      function questionsPinned() {
        return request.resource.data.questions == resource.data.questions
          || resource.data.phase == 'lobby'
          || request.resource.data.phase == 'lobby'
          || onlyTheQuestionInPlayMoved();
      }

      // The writer's own entry is the only one a rule can check without
      // iterating the map, which rules cannot do. A member can still write a
      // neighbour's entry — see the `update` rule.
      function ownEntryOk() {
        return !request.resource.data.players.keys().hasAny([request.auth.uid])
          || playerOk(request.resource.data.players[request.auth.uid]);
      }

      // Invariants every write preserves, so no member can leave the room in a
      // state the client cannot render or the free tier cannot afford. The phase
      // list matters: App.tsx matches phases exhaustively, so an unrecognised one
      // renders an empty screen for everybody in the room.
      // Whether this write is what puts a new question in front of the room, as
      // opposed to any other write while one happens to be open — a player
      // joining mid-question is also an update with `phase: 'question'`.
      function opensAQuestion() {
        return request.resource.data.phase == 'question'
          && (resource.data.phase != 'question'
              || resource.data.index != request.resource.data.index);
      }

      // The answer window, in seconds. Chosen in the lobby, and read by the
      // reveal rule below rather than hardcoded there, so a ten-second round
      // does not sit through a twenty-second gate.
      //
      // Bounds, not the lobby's own three options, and the floor is the point.
      // Any member can restart a question — write the room to a non-question
      // phase and back again and `openedAt` is restamped — which was harmless
      // while the gate was a fixed twenty seconds, because restarting could only
      // ever push the vault further away. A window that is read from the
      // document turns that same move into a way to pull the gate *closer*, so
      // what stops it being a silent cheat is that it cannot go below five
      // seconds and cannot happen without the whole room watching the timer
      // jump. Vandalism, and loud.
      function minDuration() { return 5; }
      function maxDuration() { return 120; }

      // `is number`, not `is int`, for the same reason as `joinedAt` above: the
      // wire type is the SDK's choice, and a round that cannot be revealed is a
      // far worse failure than a float slipping past a bound. The reveal rule
      // multiplies this out in milliseconds rather than handing it to
      // `duration.value`, which takes an int and would reject a double outright
      // — denying every reveal in the room and stopping the round dead.
      function durationOk() {
        return request.resource.data.get('durationSecs', 20) is number
          && request.resource.data.get('durationSecs', 20) >= minDuration()
          && request.resource.data.get('durationSecs', 20) <= maxDuration();
      }

      // `openedAt` is the server's own record of when the current question went
      // live, and the vault's time gate is measured from it. Opening a question
      // must stamp it with `request.time` — which only `serverTimestamp()`
      // satisfies — and every other write must leave it exactly as it was.
      //
      // Without the second half, a member could hold a question open, rewrite
      // `openedAt` into the past, and unlock the answer while the clock was
      // still running. `get` with a default covers a room created before these
      // fields existed, and a lobby that has never had a question at all.
      //
      // The window is pinned by the same rule and for a sharper reason. If a
      // member could lower `durationSecs` while a question was open, they would
      // open the vault early while everybody else still believed they had the
      // time the timer was showing them — a silent cheat, which is the exact
      // class the vault exists to kill. Both fields therefore move only on the
      // write that opens a question, so the worst that remains is choosing a
      // short window *before* the round starts, which everyone can see.
      function timingOk() {
        return opensAQuestion()
          ? request.resource.data.openedAt == request.time
          : request.resource.data.get('openedAt', null) == resource.data.get('openedAt', null)
            && request.resource.data.get('durationSecs', 20)
                 == resource.data.get('durationSecs', 20);
      }

      function wellFormed() {
        return request.resource.data.code == code
          && request.resource.data.phase in
               ['lobby', 'question', 'reveal', 'scoreboard', 'standoff', 'finished']
          && request.resource.data.players.keys().size() <= maxPlayers()
          && request.resource.data.scores.keys().size() <= maxPlayers()
          && request.resource.data.questions.size() <= maxQuestions()
          && request.resource.data.get('lastPicks', {}).size() <= maxPlayers()
          && durationOk()
          && ownEntryOk()
          && ownVoteOk()
          && voteGenOk()
          && cannonOk();
      }

      // The Slop Cannon's loaded shots (docs/decisions/slop-cannon.md, B4):
      // absent, or a map of at most 8 keys whose every value is `true`. Rules
      // cannot walk a map, so a key's length is not bounded here — it is a field
      // name, which Firestore caps at 1,500 bytes, and only the host writes it
      // (`selfWrite` keeps members to their own keys), the same trust as the
      // room's `questions`. The value check is what stops a page of text riding
      // under a short key, which is the S2 gap the vote had.
      function cannonOk() {
        return !('cannon' in request.resource.data)
          || (request.resource.data.cannon is map
              && request.resource.data.cannon.size() <= 8
              && request.resource.data.cannon.values().hasOnly([true]));
      }

      // What may sit under the writer's own key if a client still writes the
      // lobby vote onto the room (S2, 22 October 2026). The app no longer does
      // — PROJ-34 moved the tap to the Realtime Database — but an old bundle
      // can, and `onlyMine` says whose key moved, not what was written. A
      // ~900 kB string there is re-read by every client on every transition.
      //
      // 64 and 1000 are ceilings on size, not the game's limits. In
      // `wellFormed` rather than `selfWrite`, so the host's own key is held to
      // it too. Rules cannot walk a map, so only the writer's key is checked.
      function ownVoteOk() {
        return (!(request.auth.uid in request.resource.data.get('packVotes', {}))
            || (request.resource.data.packVotes[request.auth.uid] is string
                && request.resource.data.packVotes[request.auth.uid].size() <= 64))
          && (!(request.auth.uid in request.resource.data.get('voteTaps', {}))
            || (request.resource.data.voteTaps[request.auth.uid] is int
                && request.resource.data.voteTaps[request.auth.uid] <= 1000));
      }

      // Which Realtime Database generation the lobby is reading (PROJ-34).
      // Minted by `start` and `reset` in the phase write. A short id: it is on
      // the document every client already reads, and an unbounded string there
      // is the S2 gap again. Absent on a room that has not minted one.
      function voteGenOk() {
        return !('voteGen' in request.resource.data)
          || (request.resource.data.voteGen is string
              && request.resource.data.voteGen.size() > 0
              && request.resource.data.voteGen.size() <= 40
              && request.resource.data.voteGen.matches('^[A-Za-z0-9_-]+$'));
      }

      // ── Host authority (W3) ─────────────────────────────────────────────
      //
      // A room made since W3 names its host in `hostUid`, and only that uid may
      // move the game on: phase, index, questions, settings, titles,
      // `browsing`, scores, other players' seats, the reveal and `hostUid`
      // itself. Every member keeps the writes about themselves. A room with no
      // `hostUid` was made before W3 and keeps the member rule below until it
      // expires — expand, then contract. docs/decisions/host-authority.md.
      //
      // `get('hostUid', null) is string` rather than `in`: every client since
      // W3 carries the field on `RoomState`, and a harness that spreads the
      // whole state writes it as null. Null is a room made the old way.
      function hosted() {
        return resource.data.get('hostUid', null) is string;
      }

      function isHost() {
        return resource.data.hostUid == request.auth.uid;
      }

      // The host may write anything the shape checks allow, but may not drop
      // the field: that would turn the room back into one any member may write.
      function stillHosted() {
        return request.resource.data.get('hostUid', null) is string
          && request.resource.data.hostUid.size() <= 128;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Within one of the room's per-player maps, only the writer's own key moved.
      function onlyMine(field) {
        return request.resource.data.get(field, {})
          .diff(resource.data.get(field, {})).affectedKeys()
          .hasOnly([request.auth.uid]);
      }

      // What a member writes about themselves (`writeSelfIntoRoom`, `leave`,
      // `writeOwnSquad`, `writeOwnVote`): their seat, their score, their vote
      // and their tap count, and nothing else. A score a member writes is never
      // new — `planJoin` writes the score already there, or zero.
      function selfWrite() {
        return changed().hasOnly(['players', 'scores', 'packVotes', 'voteTaps'])
          && onlyMine('players')
          && onlyMine('scores')
          && onlyMine('packVotes')
          && onlyMine('voteTaps')
          && (request.resource.data.scores.get(request.auth.uid, 0) == 0
              || request.resource.data.scores.get(request.auth.uid, 0)
                   == resource.data.scores.get(request.auth.uid, 0));
      }

      // The claim threshold. `CLAIM_AFTER_SILENT_MS` in src/engine/host.ts
      // holds the same number and host.test.ts fails if they differ. 75 s, not
      // 30: a hidden tab's timers can run once a minute (Chrome's intensive
      // throttling), and a throttled host must keep the chair.
      function beatSilentMs() { return 75000; }

      function beatPath() {
        return /databases/$(database)/documents/rooms/$(code)/host/beat;
      }

      // The host's beat has gone quiet. `get`, not `getAfter`: the claim batch
      // writes a fresh beat beside it, and the question is about the old one.
      // A room with no beat at all has a host that never beat.
      function beatSilent() {
        return !exists(beatPath())
          || get(beatPath()).data.at.toMillis() + beatSilentMs() < request.time.toMillis();
      }

      // A member takes the chair, and changes nothing else in the same write.
      // The client asks only when the host's presence has gone (`planClaim`);
      // the rule asks only about the beat, so a rogue claim needs 75 silent
      // seconds first, and a second claimant finds the first one's fresh beat.
      function claim() {
        return isMember()
          && changed().hasOnly(['hostUid'])
          && request.resource.data.hostUid == request.auth.uid
          && beatSilent();
      }

      // Anyone signed in can look up a room in order to join it.
      //
      // `list` is not granted. The app never queries the collection, so allowing
      // it costs nothing to drop and would otherwise let any anonymous visitor
      // enumerate every live room — its players, its scores, its questions and
      // every `correctIndex` — and write to all of them. A four-character code is
      // only a reasonable secret while it cannot be harvested in one query.
      allow get: if signedIn();

      // Creating a room means putting yourself in it as the only player, in a
      // lobby with no questions yet. `newJoinedAtOk` rather than
      // `ownJoinedAtOk`: there is no `resource` on create.
      allow create: if signedIn()
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        // `hasOnly` is satisfied by the empty map, which would mint a room with
        // no members and so no derivable quizmaster.
        && request.resource.data.players.keys().size() == 1
        && request.resource.data.phase == 'lobby'
        && request.resource.data.questions.size() == 0
        // The creator is the host. Absent or null is a client from before W3,
        // accepted until the contract deploy.
        && (request.resource.data.get('hostUid', null) == null
            || request.resource.data.hostUid == request.auth.uid)
        && wellFormed()
        && newJoinedAtOk();

      // Joining is also an update, so a writer may be a member either before
      // or after the write.
      //
      // **A room with a host** (made since W3): the host drives it, members
      // write only about themselves, and a member may claim the chair once the
      // host's beat has been silent for 75 s.
      //
      // **A room without one** (made before W3): any member can still
      // overwrite the phase, the scores and other players, because there the
      // quizmaster is derived rather than stored. `wellFormed` keeps the worst
      // case to mischief. This branch goes in the contract deploy, once every
      // such room has passed `expiresAt`.
      //
      // `questionsPinned` holds in both: rewriting the question list
      // mid-round was an unlimited vault oracle; see
      // docs/decisions/security-round-sept-2026.md.
      allow update: if signedIn()
        && (isMember() || request.resource.data.players.keys().hasAny([request.auth.uid]))
        && wellFormed()
        && timingOk()
        && questionsPinned()
        && ownJoinedAtOk()
        && (!hosted()
            || (isHost() ? stillHosted() : (selfWrite() || claim())));

      // Rooms are disposable; nobody needs to delete one mid-quiz.
      allow delete: if false;

      match /answers/{uid} {
        // The parent room, for the arrival floor and the read below. `exists()`
        // first where it matters: a `get()` on a missing document returns null,
        // and reading `.data` off null errors the rule, which denies. Both hit
        // the same document in one evaluation, so Firestore caches them as one
        // read.
        function answerRoom() {
          return get(/databases/$(database)/documents/rooms/$(code));
        }

        // **W3: the host and the author only.** Until the reveal nobody else
        // may see a pick; the host's reveal write then publishes them on the
        // room (`lastPicks`), which every device is already listening to. A
        // room made before W3 has no `hostUid` and stays readable by everyone
        // signed in, as it was.
        //
        // This now `get()`s the room, which `cost.md` warned against when
        // every client held a listener here. Now one listener does, the
        // host's, so the term is about Q·N rather than Q·N². **Not measured:**
        // whether a rules `get()` on a listener is billed per snapshot.
        // `sync-harness 30` after the deploy is the count (AC10).
        function mayReadAll() {
          return answerRoom().data.get('hostUid', null) == null
            || answerRoom().data.hostUid == request.auth.uid;
        }

        // Your own first, so it costs no room read.
        allow get: if signedIn() && (request.auth.uid == uid || mayReadAll());
        allow list: if signedIn() && mayReadAll();

        // How late a write may land after the claimed tap. Eight seconds,
        // not three: the 17 August office delay was five, the named flaky
        // write is four, and three would have refused the player the shared
        // clock was built for. Defended in docs/decisions/answer-window.md.
        function elapsedGraceMs() { return 8000; }

        // You cannot claim to have answered much faster than this write
        // actually landed. `elapsedMs` is still measured on the device; this
        // is a server-provable *lower* bound, not a lock. A change of mind
        // is still allowed — the restamp has to be consistent with arrival
        // too, which is what stops a crafted client keeping a 3ms stamp
        // while revising at leisure.
        //
        // `firstMs` is the same clock and does **not** take this floor.
        // Applying it would refuse an honest change of mind after grace
        // (first touch at 50ms, revise at 12s), which is making the first
        // pick final — turned down in docs/decisions/answer-spam.md. It
        // still cannot be later than the stamp that stands.
        //
        // Compared in milliseconds rather than with `duration.value`, same
        // reason as `windowClosed` on the reveal: a double from the SDK
        // would error the rule and deny every answer in the room.
        function arrivalOk() {
          return exists(/databases/$(database)/documents/rooms/$(code))
            && answerRoom().data.openedAt is timestamp
            && request.resource.data.elapsedMs
                 >= request.time.toMillis()
                      - answerRoom().data.openedAt.toMillis()
                      - elapsedGraceMs();
        }

        // You may only write your own answer, and only with a sane shape.
        // `elapsedMs` is measured on the answering device; `arrivalOk` is
        // the anti-cheat the 0–600000 bounds never were. See
        // docs/decisions/answer-window.md.
        // `firstMs` is when that device first touched a lectern on this
        // question, and is present only once a pick has been changed — the
        // same optional shape as `wager`, and ceiling-bounded the same way
        // as `elapsedMs`. It is shown at the reveal and scored nowhere, so
        // a client that lies about it wins nothing; see
        // docs/decisions/answer-spam.md.
        // `wager` is the share of their own points a player put on the
        // question, 0-100. A *share* and not a number of points, deliberately:
        // the wire field stays a percentage and the engine decides what it is
        // worth, including a 500-point floor on a positive stake. That floor
        // is what can put a season total below zero, which is why `points`
        // is bounded by `-maxPoints()` rather than 0.
        //
        // Which question it belongs to is still not checked: that would be
        // a second use of the room `get()` we now pay for the floor, and
        // the engine already settles it — `isWagerQuestion` honours a stake
        // only on the last question of a round the room agreed to play for
        // stakes, so a wager sent on any other is ignored by every client
        // alike.
        // `at` is the server's stamp of when this write landed, optional so
        // a bundle that has never heard of it still scores. When present it
        // must be `request.time` — `serverTimestamp()` and nothing else —
        // so a client cannot backdate it. Rank still reads `elapsedMs`.
        // Paste this before deploying the client that writes it, or every
        // answer is refused in silence.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['optionIndex', 'elapsedMs', 'questionIndex', 'wager', 'firstMs', 'at'])
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < 10
          && request.resource.data.elapsedMs is int
          && request.resource.data.elapsedMs >= 0
          && request.resource.data.elapsedMs <= 600000
          && request.resource.data.questionIndex is int
          && request.resource.data.questionIndex >= 0
          && request.resource.data.questionIndex < 100
          && (!('wager' in request.resource.data.keys())
            || (request.resource.data.wager is int
              && request.resource.data.wager >= 0
              && request.resource.data.wager <= 100))
          && (!('firstMs' in request.resource.data.keys())
            || (request.resource.data.firstMs is int
              && request.resource.data.firstMs >= 0
              && request.resource.data.firstMs <= 600000
              && request.resource.data.firstMs <= request.resource.data.elapsedMs))
          && (!('at' in request.resource.data.keys())
            || request.resource.data.at == request.time)
          && arrivalOk();

        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // ── The reveal ────────────────────────────────────────────────────────
      //
      // How the answer gets out of the vault, and the only way it ever does.
      //
      // Nobody can read the vault, so nobody can look an answer up. What they
      // can do is *assert* one — write `{ answer: "Metropolitan Line" }` here —
      // and this rule judges it against the vault. Trying all four options
      // finds the answer in four attempts, which would be a fine way to cheat
      // if the same rule did not refuse every one of them until:
      //
      //   1. the question named in the path is the one actually in play, and
      //   2. the server itself has seen the room's answer window pass since it
      //      opened.
      //
      // The first *used* to claim it stopped a member holding question one
      // open and quietly asking about the other fourteen. It did not: the
      // room could rewrite `questions` without moving phase or index, so
      // `opensAQuestion()` stayed false and `timingOk()` was satisfied.
      // `questionsPinned()` on the room update is what actually stops that.
      // The second means nobody — in this room or in a decoy of their own —
      // can ask before the answering window has already closed, because
      // `openedAt` can only be written as `request.time` and `durationSecs`
      // cannot move while a question is open. The accepted decoy (one gate
      // per question, five-second floor) is unchanged.
      //
      // What this does not stop is written down in docs/HANDOVER.md. The short
      // version: the questions come from a public database, so a determined
      // attacker was always going to win. This kills the ten-second one.
      match /reveal/{questionId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }

        // Both calls read the same document, and Firestore caches identical
        // document accesses within one rule evaluation, so this costs one read.
        //
        // Compared in milliseconds rather than with `duration.value`, which
        // takes an int: `durationSecs` arrives from a client SDK that decides
        // for itself whether a whole number goes on the wire as an integer or a
        // double, and handing it a double would error the rule and deny every
        // reveal in the room. Plain arithmetic does not care which it got.
        //
        // The default keeps rooms that were already in flight when this shipped
        // working on the twenty seconds their clients still expect.
        function windowClosed() {
          return room().openedAt is timestamp
            && request.time.toMillis()
                 > room().openedAt.toMillis() + room().get('durationSecs', 20) * 1000;
        }

        function isTheQuestionInPlay() {
          return room().questions.size() > room().index
            && room().questions[room().index].id == questionId;
        }

        // W3: only the host asks the vault, in a room that has one.
        function mayReveal() {
          return room().get('hostUid', null) == null
            || room().hostUid == request.auth.uid;
        }

        // Everyone reads the reveal, so a client that missed the room update
        // can still find out what the answer was.
        allow read: if signedIn();

        allow create: if signedIn()
          && mayReveal()
          && request.resource.data.keys().hasOnly(['answer'])
          && request.resource.data.answer is string
          && isTheQuestionInPlay()
          && windowClosed()
          && request.resource.data.answer
               == get(/databases/$(database)/documents/vault/$(questionId)).data.a;

        // Never rewritten: a settled reveal must not change under the room's
        // feet, and an answer that was true when it was written stays true.
        allow update: if false;

        // Deleting one is allowed, and buys nothing. Re-running the four-way
        // guess afterwards is subject to the same gate as the first time, so it
        // cannot uncover anything earlier than it already could. What it costs
        // is that a member can wipe a reveal mid-round out of mischief — the
        // same class of nuisance as rewriting the phase, which the quizmaster
        // being derived rather than stored already permits. In exchange the
        // preflight can exercise this path on every run instead of once ever.
        // Since W3, in a room with a host, only the host.
        allow delete: if signedIn() && mayReveal();
      }

      // ── The host's heartbeat (W3) ─────────────────────────────────────────
      //
      // `rooms/{code}/host/beat`, `{ at }`, written by the host every 15 s and
      // read by nobody but the claim rule above. `getAfter`, not `get`: the
      // claim batch makes the claimant host and writes this in one commit, and
      // the room has to be read as it will be once that lands.
      match /host/{name} {
        allow read: if false;

        allow create, update: if signedIn()
          && name == 'beat'
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/rooms/$(code)).data.get('hostUid', null)
               == request.auth.uid;

        allow delete: if false;
      }

      // ── Share or Shaft ────────────────────────────────────────────────────
      //
      // A finalist's sealed pick, one document per player. The scheme is in
      // src/engine/sealedPick.ts; the decisions are in
      // docs/decisions/share-or-shaft.md.
      //
      // Readable by everyone, like answers, and safe for a different reason:
      // tapping writes a SHA-256 of the pick and a 128-bit nonce, never the
      // pick. The pick and nonce are added only once both commitments exist,
      // and every client checks them against the hash. So these rules do not
      // decide whether a pick counts — the engine does, identically on every
      // device, and ignores a document from anybody who is not a finalist, as
      // it ignores a `wager` sent on the wrong question.
      //
      // What the rules must give is the one property a hash cannot: a
      // commitment that cannot move once the other finalist has revealed.
      // Pinning it within a document is not enough on its own. "Another round"
      // reuses the room, so a new `gameId` has to be able to replace last
      // round's commitment — and if any `gameId` could, a finalist could hop
      // to a made-up one and back, re-committing after reading the reveal. So
      // the `gameId` must be the room's own: one `get()` per pick, a handful
      // of writes a game.
      match /standoff/{uid} {
        function roomGameId() {
          return get(/databases/$(database)/documents/rooms/$(code)).data.get('gameId', null);
        }

        function commitmentOk() {
          return request.resource.data.keys().hasOnly(['gameId', 'commit'])
            && request.resource.data.gameId is string
            && request.resource.data.gameId == roomGameId()
            && request.resource.data.commit is string
            && request.resource.data.commit.size() == 64;
        }

        function revealOk() {
          return request.resource.data.keys().hasOnly(['gameId', 'commit', 'pick', 'nonce'])
            && request.resource.data.gameId == resource.data.gameId
            && request.resource.data.commit == resource.data.commit
            && request.resource.data.pick in ['share', 'shaft']
            && request.resource.data.nonce is string
            && request.resource.data.nonce.size() <= 64;
        }

        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && commitmentOk();

        // The reveal, or a fresh commitment for the round the room is now on.
        allow update: if signedIn()
          && request.auth.uid == uid
          && (revealOk()
            || (request.resource.data.gameId != resource.data.gameId
              && exists(/databases/$(database)/documents/rooms/$(code))
              && commitmentOk()));

        // Your own, and never while a final is on: deleting and re-creating
        // mid-final would re-commit exactly as the `gameId` hop would. Outside
        // one there is nothing left to protect, and `check-rules` sweeps its
        // probe pick rather than leave one behind on every run. `prune-rooms`
        // removes the rest with their room, through the Admin SDK.
        allow delete: if signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/rooms/$(code)).data.phase != 'standoff';
      }
    }

    // ── What the room thought of a question ───────────────────────────────────
    //
    // A global collection rather than a room subcollection, and every reason is
    // about cost or about the data outliving the room it was collected in — see
    // `src/lib/questionVotes.ts`, which carries the argument in full.
    //
    // **Nothing here can leak an answer.** The document is one field, `good` or
    // `bad`, written after the reveal. There is no option index in it, which is
    // the same discipline the difficulty counters are designed to: a per-option
    // breakdown would make the modal answer guessable and hand back precisely
    // what the vault exists to protect.
    //
    // `read` is denied outright, to clients and to the app alike. Nothing shows
    // a tally — the fold that turns these into a retirement list runs on the
    // Admin SDK, which is not subject to these rules at all — and a collection
    // nobody can enumerate is a collection nobody can mine. Granting `list`
    // later is one rules change, and is what a live tally would need.
    //
    // The document id is the voter's uid, so one person's opinion of a question
    // counts once. `update` is allowed for the same reason it is on an answer:
    // changing your mind is not cheating.
    match /questionVotes/{questionId}/votes/{uid} {
      allow read: if false;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['verdict'])
        && request.resource.data.verdict in ['good', 'bad'];

      // Your own, and only your own — the answers rule exactly.
      //
      // `delete: if false` was written here first and was a mistake worth
      // recording: it buys nothing, because `update` already lets anybody flip
      // their own verdict to `good`, and it costs a row **no client can ever
      // remove**. `check-rules` writes to this path on every run, so that is a
      // preflight leaving permanent litter behind — the precise failure
      // `HANDOVER.md` records having to sweep with `prune-rooms --probe-rows`.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── What each device saw of question one ─────────────────────────────────
    //
    // One document per player per round, written by that player's device once
    // it has seen question one revealed, read by nobody but `npm run
    // read-traces`. Built for Cass, who loses question one on 10-second rounds
    // with her answers landing seconds behind her own clock; the kept rounds
    // cannot say whether her device saw the question late or wrote slowly, and
    // this can. docs/decisions/cass-q1.md; the shape is `src/engine/q1Trace.ts`.
    //
    // Global rather than in the room for the votes' reasons: no listener, no
    // reads, and it outlives `prune-rooms`. **No answer content** — no option
    // index, written after the reveal.
    //
    // Create only, as yourself, under `{gameId}_{uid}`, so one device files one
    // trace a round and cannot file anybody else's. `update` is refused: the
    // client never sends one, so a second write is a bug and should fail.
    // `delete` is your own, so `check-rules` leaves no litter (the vote block's
    // lesson). Every number is bounded, and the client clamps to the same
    // bounds so a strange reading is kept rather than refusing the trace.
    match /q1Traces/{traceId} {
      function trace() {
        return request.resource.data;
      }

      // An optional whole number inside [low, high].
      function intIn(key, low, high) {
        return !(key in trace().keys())
          || (trace()[key] is int && trace()[key] >= low && trace()[key] <= high);
      }

      function textUpTo(key, size) {
        return !(key in trace().keys()) || (trace()[key] is string && trace()[key].size() <= size);
      }

      allow read, update: if false;

      allow create: if request.auth != null
        && trace().keys().hasAll(['gameId', 'roomCode', 'uid', 'durationMs', 'correctionMs', 'priorSamples', 'writes', 'device', 'at'])
        && trace().keys().hasOnly(['gameId', 'roomCode', 'uid', 'durationMs', 'correctionMs', 'priorSamples', 'writes', 'device', 'network', 'seenAfterOpenMs', 'serverOffsetMs', 'visibleForMs', 'tapMs', 'tapElapsedMs', 'ackMs', 'refused', 'dropped', 'revealMs', 'counted', 'at'])
        && trace().uid == request.auth.uid
        && trace().gameId is string
        && trace().gameId.size() > 0
        && trace().gameId.size() <= 64
        && traceId == trace().gameId + '_' + request.auth.uid
        && trace().roomCode is string
        && trace().roomCode.size() <= 8
        && trace().at == request.time
        && trace().device in ['ios', 'android', 'mac', 'windows', 'linux', 'other']
        && trace().durationMs is int && trace().durationMs >= 0 && trace().durationMs <= 600000
        && trace().correctionMs is int && trace().correctionMs >= 0 && trace().correctionMs <= 600000
        && trace().priorSamples is int && trace().priorSamples >= 0 && trace().priorSamples <= 1000
        && trace().writes is int && trace().writes >= 0 && trace().writes <= 1000
        && intIn('seenAfterOpenMs', -86400000, 86400000)
        && intIn('serverOffsetMs', -86400000, 86400000)
        && intIn('visibleForMs', 0, 86400000)
        && intIn('tapMs', 0, 600000)
        && intIn('tapElapsedMs', 0, 600000)
        && intIn('ackMs', 0, 600000)
        && intIn('revealMs', 0, 600000)
        && textUpTo('network', 16)
        && textUpTo('refused', 40)
        && (!('dropped' in trace().keys()) || trace().dropped in ['phase', 'window'])
        && (!('counted' in trace().keys()) || trace().counted is bool);

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── What players were shown going wrong ──────────────────────────────────
    //
    // The error beacon (docs/decisions/slop-cannon.md, A). Every `.notice` a
    // player sees, and every uncaught error, one row each — read by nobody but
    // `npm run read-errors`. Built for 22 October 2026, when every device showed
    // a refusal over the podium and nothing anywhere recorded it.
    //
    // **No uid, no names, no answers.** An auto-id, so nothing in the path names
    // the writer either. Create only: the client never updates, and with no uid
    // there is nobody a delete could be granted to — `read-errors` skips
    // `check-rules`'s probe rows instead. Every field bounded; the client clamps
    // to the same bounds (`src/engine/clientError.ts`).
    match /clientErrors/{errorId} {
      function beacon() {
        return request.resource.data;
      }

      function optionalText(key, size) {
        return !(key in beacon().keys())
          || (beacon()[key] is string && beacon()[key].size() > 0 && beacon()[key].size() <= size);
      }

      allow read, update, delete: if false;

      allow create: if request.auth != null
        && beacon().keys().hasAll(['message', 'source', 'build', 'device', 'at'])
        && beacon().keys().hasOnly(['message', 'source', 'build', 'device', 'room', 'phase', 'gameId', 'at'])
        && beacon().message is string
        && beacon().message.size() > 0
        && beacon().message.size() <= 300
        && beacon().source in ['notice', 'error', 'rejection']
        && beacon().build is string
        && beacon().build.size() > 0
        && beacon().build.size() <= 32
        && beacon().device in ['ios', 'android', 'mac', 'windows', 'linux', 'other']
        && optionalText('room', 8)
        && optionalText('gameId', 64)
        && (!('phase' in beacon().keys())
            || beacon().phase in ['lobby', 'question', 'reveal', 'scoreboard', 'standoff', 'finished'])
        && beacon().at == request.time;
    }

    // ── The Slop Cannon ──────────────────────────────────────────────────────
    //
    // docs/decisions/slop-cannon.md. The kill switch (C2): one document,
    // `config/cannon`, read once per page load by a signed-in client and written
    // only by the Admin SDK (`npm run cannon`). `get` only, and only that one
    // document, so nothing else under `config/` is readable by accident.
    match /config/{name} {
      allow get: if request.auth != null && name == 'cannon';
      allow list, write: if false;
    }

    // Keep / Bin (D3): one per player per shot per round, under
    // `{gameId}_{shot}_{uid}`, so the id is the dedupe. Create only — no change
    // of mind, and a second tap is an update the rules refuse. Delete your own,
    // so `check-rules` leaves no litter (the vote block's lesson). Read by
    // nobody but `npm run read-cannon`. Self-reported, as a question vote is:
    // nothing checks you were in the round, which would cost a `get()` a vote.
    match /cannonVerdicts/{verdictId} {
      function verdict() {
        return request.resource.data;
      }

      allow read, update: if false;

      allow create: if request.auth != null
        && verdict().keys().hasOnly(['gameId', 'shot', 'verdict', 'uid', 'at'])
        && verdict().keys().hasAll(['gameId', 'shot', 'verdict', 'uid', 'at'])
        && verdict().uid == request.auth.uid
        && verdict().gameId is string
        && verdict().gameId.size() > 0
        && verdict().gameId.size() <= 64
        && verdict().shot is string
        && verdict().shot.size() > 0
        && verdict().shot.size() <= 32
        && verdict().verdict in ['keep', 'bin']
        && verdictId == verdict().gameId + '_' + verdict().shot + '_' + request.auth.uid
        && verdict().at == request.time;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── The round, kept ──────────────────────────────────────────────────────
    //
    // One document per finished game, written by the quizmaster's device when
    // the room reaches `finished` and read by nobody but `npm run read-games`.
    // The answers subcollection is overwritten every question, so this is the
    // only place a round's responses survive — the reason every "did that
    // feature play well?" has ended on "hard to say". See
    // `src/engine/gameRecord.ts` for what it holds and
    // `src/lib/gameRecords.ts` for why it is global rather than in the room.
    //
    // Bounded at the top level only. Rules cannot walk a list, so what is
    // inside `questions` is trusted — the same trust as the room's own
    // `questions` array, and capped by the same 1 MiB document limit. The
    // headcount and question-count ceilings mirror `maxPlayers()` and
    // `maxQuestions()`, which are scoped to `/rooms` and cannot be reached here.
    //
    // `finishedAt == request.time` pins the stamp to the server's clock.
    // `writtenBy` must be the writer and must be in the game: a record of a
    // round you were not in is not yours to file.
    //
    // `update` is refused so a record cannot be rewritten after the fact.
    // `delete` is allowed to the writer, for the reason the vote block gives
    // above: `check-rules` creates one of these on every run, and a row no
    // client can remove is permanent litter. It costs nothing worth protecting
    // — a record is self-reported, exactly as a season row is.
    match /games/{gameId} {
      function gameOk() {
        return request.resource.data.keys().hasOnly([
            'roomCode', 'packId', 'packTitle', 'durationSecs', 'wagerEnabled',
            'stealEnabled', 'jigsawEnabled', 'players', 'scores', 'questions',
            'writtenBy', 'finishedAt', 'doubleOf', 'cannon',
          ])
          && request.resource.data.keys().hasAll([
            'roomCode', 'packId', 'packTitle', 'durationSecs', 'wagerEnabled',
            'stealEnabled', 'jigsawEnabled', 'players', 'scores', 'questions',
            'writtenBy', 'finishedAt',
          ])
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() <= 32
          && request.resource.data.packId is string
          && request.resource.data.packId.size() <= 64
          && request.resource.data.packTitle is string
          && request.resource.data.packTitle.size() <= 128
          && request.resource.data.durationSecs is int
          && request.resource.data.wagerEnabled is bool
          && request.resource.data.stealEnabled is bool
          && request.resource.data.jigsawEnabled is bool
          && request.resource.data.players is map
          && request.resource.data.players.size() <= 60
          && request.resource.data.scores is map
          && request.resource.data.scores.size() <= 60
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 50
          // Round two of The Double names round one. Optional, so a bundle from
          // before it is not refused (docs/decisions/morning-double.md).
          && (!('doubleOf' in request.resource.data)
              || (request.resource.data.doubleOf is string
                  && request.resource.data.doubleOf.size() <= 64))
          // The Slop Cannon's shots, when any were loaded: the room's own bound.
          && (!('cannon' in request.resource.data)
              || (request.resource.data.cannon is map
                  && request.resource.data.cannon.size() <= 8
                  && request.resource.data.cannon.values().hasOnly([true])))
          && request.resource.data.writtenBy == request.auth.uid
          && request.auth.uid in request.resource.data.players
          && request.resource.data.finishedAt == request.time;
      }

      allow read: if false;
      allow create: if request.auth != null && gameOk();
      allow update: if false;
      allow delete: if request.auth != null && resource.data.writtenBy == request.auth.uid;
    }

    // Season standings. Unlike room scores, these can be locked down properly:
    // a player writes only their own row, so the rules enforce exactly the
    // invariant the app relies on. The values themselves are still self-
    // reported — nothing here stops someone inflating their own total, which is
    // the same trust model as the rest of the game. The bounds below only keep
    // a self-report within the range a real season could produce, so one edited
    // row cannot make the whole table meaningless.
    // What each pack has already served this season, so a round can prefer
    // questions nobody has seen. Not secret — it is a list of ids, and the
    // answers are in the vault — but it is worth bounding, because every client
    // starting a round writes it and an unbounded array on a document read at
    // the top of every game is exactly the shape this project keeps avoiding.
    match /seasons/{season}/asked/{packId} {
      function signedIn() {
        return request.auth != null;
      }

      allow read: if signedIn();

      function historyOk() {
        return request.resource.data.keys().hasOnly(['ids', 'at'])
          && request.resource.data.ids is list
          // Matches ASKED_LIMIT in src/lib/season.ts, with room to spare so a
          // client one deploy behind is not locked out of writing its history.
          && request.resource.data.ids.size() <= 600
          && request.resource.data.at is number;
      }

      allow create: if signedIn() && historyOk();

      // Never shorter than what is there (audit, 22 October 2026). The client
      // writes the stored ids plus this round's, capped at ASKED_LIMIT
      // (`mergeAsked`), so a real write never shrinks the list. Without this,
      // an update to `ids: []` wiped a pack's history as surely as a delete.
      // A lost race between two rooms is now refused rather than overwriting
      // the other room's ids; `recordAsked` already swallows a failure.
      allow update: if signedIn() && historyOk()
        && request.resource.data.ids.size() >= resource.data.ids.size();

      // Clearing a pack's history starts it fresh without a new season. It
      // used to be open to anyone signed in, which let any visitor wipe it; the
      // client never deleted (grep, 22 October 2026). The console and the
      // Admin SDK still can.
      allow delete: if false;
    }

    match /seasons/{season}/players/{playerId} {
      // A round is at most 25 questions at 1,000 points, so 100k left room for a
      // long season's best game and still rejected a fantasy number. Share or
      // Shaft can then hand one finalist both finalists' scores, so a game's
      // best is up to twice what one player can score — 200k, or the stealer's
      // bank is refused and their night is lost. docs/decisions/share-or-shaft.md.
      function maxBest() { return 200000; }
      function maxPoints() { return 100000000; }
      function maxPlayed() { return 10000; }

      function signedIn() {
        return request.auth != null;
      }

      // The whole table is readable by any signed-in visitor, which anonymous
      // auth makes effectively public. It holds display names and scores only,
      // and a shared leaderboard has to be shared — but it is a deliberate
      // choice, not an oversight. See docs/HANDOVER.md.
      allow read: if signedIn();

      // Four rosettes, so a shelf cannot hold more of any one of them than there
      // were rounds to win it in. Defaulted rather than required: a row written
      // before honours existed carries none, and a client one deploy behind
      // writes none, and neither should be locked out of its own row.
      function honourOk(d, field) {
        let count = d.get(field, 0);
        return count is int && count >= 0 && count <= d.played;
      }

      // Best four of the last six. Optional: every live row predates the
      // fields, and a client one deploy behind writes none. Required would
      // lock those rows out. The *new* client writes both on every bank, so
      // the published hasOnly list refuses those writes until this block is
      // live. CI publishes rules before the site in one run, which keeps that
      // order; check-rules after. Same order as firstMs and keep-the-round. Rules cannot walk a list, so the six slots are
      // unrolled; an entry past size() is skipped, not read.
      //
      // The list and the bound are passed in rather than re-read per slot: six
      // slots multiply every lookup here by six, and this rule runs close to
      // the 1,000-expression ceiling (see `finalsOk`).
      function recentEntryOk(entry, best) {
        return entry is map
          && entry.keys().hasOnly(['gameId', 'score', 'at'])
          && entry.gameId is string
          && entry.gameId.size() > 0
          && entry.gameId.size() <= 64
          && entry.score is int
          && entry.score >= 0 - best
          && entry.score <= best
          && entry.at is number;
      }

      function recentSlotOk(recent, i, best) {
        return recent.size() <= i || recentEntryOk(recent[i], best);
      }

      function recentOk(d) {
        let recent = d.get('recent', []);
        let best = maxBest();
        return recent is list
          && recent.size() <= 6
          && recent.size() <= d.played
          && recentSlotOk(recent, 0, best)
          && recentSlotOk(recent, 1, best)
          && recentSlotOk(recent, 2, best)
          && recentSlotOk(recent, 3, best)
          && recentSlotOk(recent, 4, best)
          && recentSlotOk(recent, 5, best);
      }

      function formOk(d) {
        return !('form' in d.keys())
          || (d.form is int
            && d.form >= (0 - maxBest() * 4)
            && d.form <= maxBest() * 4);
      }

      // Share or Shaft, counted the way the room saw it. A no-pick is not a
      // share, and gotShafted is the opponent's counted shaft, both-shaft
      // included. Optional, same as the rosettes: absent is zero, so a row
      // from before this and a client one deploy behind still bank. The new
      // client writes all four on every bank, and hasOnly refuses that write
      // until this block is published. CI publishes the rules before the site.
      // docs/decisions/finals-history.md.
      //
      // **Each field is read once, into a `let`.** Written as fourteen
      // `get(field, 0)` calls, this took a regular's row past the documented
      // 1,000 expressions per request: six `recent` entries plus this was
      // refused, so on 22 October 2026 nobody's round banked and every device
      // showed "Missing or insufficient permissions" over the podium. A fresh
      // row passed, which is why every check did.
      // docs/decisions/finals-history.md.
      function finalsOk(d) {
        let finals = d.get('finals', 0);
        let shared = d.get('shared', 0);
        let shafted = d.get('shafted', 0);
        let gotShafted = d.get('gotShafted', 0);
        return finals is int && finals >= 0
          && shared is int && shared >= 0
          && shafted is int && shafted >= 0
          && gotShafted is int && gotShafted >= 0
          && finals <= d.played
          && shared + shafted <= finals
          && gotShafted <= finals;
      }

      function rowOk(d) {
        return d.keys().hasOnly(
             ['name', 'played', 'wins', 'points', 'best', 'lastGame', 'lastPlayed',
              'fastest', 'comeback', 'loneWolf', 'contrarian', 'team',
              'recent', 'form',
              'finals', 'shared', 'shafted', 'gotShafted'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 40
        && d.played is int
        && d.played >= 0
        && d.played <= maxPlayed()
        && d.wins is int
        && d.wins >= 0
        // You cannot have won more rounds than you played. `best <= points`
        // went on 4 September: a lost minimum stake can put the total below
        // a personal best, and `best` stays a maximum against a zero floor.
        && d.wins <= d.played
        && d.points is int
        // Binary minus, not unary: the console compiler rejects `-maxPoints()`
        // with Unexpected EOF still expecting an operator.
        && d.points >= (0 - maxPoints())
        && d.points <= maxPoints()
        && d.best is int
        && d.best >= 0
        && d.best <= maxBest()
        && d.lastGame is string
        && d.lastGame.size() <= 64
        && d.lastPlayed is number
        // After `played` has been checked, because that is what they are bounded
        // against and rules evaluate left to right.
        && honourOk(d, 'fastest')
        && honourOk(d, 'comeback')
        && honourOk(d, 'loneWolf')
        && honourOk(d, 'contrarian')
        // `team` was bounded here ahead of its client, because the season row is
        // validated with `hasOnly` and *any* new field on it costs a rules
        // republish — and a hand-pasted ruleset has broken the game twice. It
        // shipped on 15 August 2026 and leagues were then a client-only change,
        // which was the point.
        //
        // The trap that came with it: both writers use `set`, a whole-document
        // overwrite, so a field the client's type does not name is erased by the
        // next game anybody plays. Anything else bounded here ahead of its
        // feature has to be carried through `PlayerRecord` on the same day, or
        // it will appear to work and quietly clear itself overnight.
        && d.get('team', '') is string
        && d.get('team', '').size() <= 40
        && recentOk(d)
        && formOk(d)
        && finalsOk(d);
      }

      // The row goes in once, as `d`: written against `request.resource.data`
      // at every use, this rule ran out of its 1,000-expression budget on a
      // regular's row (see `finalsOk`).
      allow create, update: if signedIn()
        && ownsPlayer(playerId)
        && rowOk(request.resource.data);


      // Removing your own row is the only way anybody can take a display name
      // back off a shared board without console access. Someone else's row still
      // needs the console — the app has no moderator.
      allow delete: if signedIn() && ownsPlayer(playerId);
    }
  }
}

rules_version = '2';

// ── SEEDING ONLY. NOT THE RULESET TO PLAY ON. ────────────────────────────────
//
// Publish this, run `npm run seed-vault`, then publish firestore.rules again.
// It exists because the vault has to be written once and must never be
// writable again, and there is no third state in between.
//
// While this is live the vault can be written by anyone signed in — which is
// anyone at all, since the project accepts anonymous auth. It is still never
// *readable*, so the answers do not leak; the exposure is that somebody could
// write nonsense into it and make the quiz mark correct answers wrong. That is
// a loud failure rather than a silent one, and the window is however long the
// seed takes, which is a couple of minutes.
//
// `npm run check-rules` fails if this ruleset is still published.
//
// Everything else is denied outright: while this is live, nobody plays.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vault/{questionId} {
      allow read: if false;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['a'])
        && request.resource.data.a is string
        && request.resource.data.a.size() > 0
        && request.resource.data.a.size() <= 300;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

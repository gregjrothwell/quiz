{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$code": {
        ".read": "auth != null",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['at'])",

          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$code": {
        ".read": "auth != null",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['at'])",

          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "rig": {
      "$code": {
        ".read": "auth != null",

        "run": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id', 'startAt', 'by']) && newData.child('by').val() === auth.uid",

          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },

        "paints": {
          "$run": {
            "$cue": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && $cue.matches(/^[0-9]$/)",
                ".validate": "newData.isNumber()"
              }
            }
          }
        }
      }
    },

    "lamps": {
      "$code": {
        "$question": {
          ".read": "auth != null",

          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },

    "lobbyVote": {
      "$code": {
        "$gen": {
          ".read": "auth != null",

          "packVotes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $gen.matches(/^[A-Za-z0-9_-]{1,40}$/)",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
            }
          },

          "voteTaps": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && newData.exists() && $gen.matches(/^[A-Za-z0-9_-]{1,40}$/)",
              ".validate": "newData.isNumber() && newData.val() <= 1000 && newData.val() % 1 == 0 && (data.exists() ? newData.val() == data.val() + 1 : newData.val() == 1)"
            }
          },

          "browsing": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $gen.matches(/^[A-Za-z0-9_-]{1,40}$/)",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
            }
          },

          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}

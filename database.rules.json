{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$code": {
        ".read": "auth != null",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('at').isNumber()"
        }
      }
    }
  }
}

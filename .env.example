# Copy to .env.local and fill from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# These values are public by design — they identify the project, they do not
# authorise access. Access is controlled by firestore.rules and
# database.rules.json, which is where the real security lives.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL — used for presence only (Firestore has no onDisconnect).
# Console -> Realtime Database -> the URL at the top, e.g.
#   https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Optional. App Check — proves a request came from the real app, which is the
# only thing standing between anonymous auth and somebody minting accounts until
# the day's free tier is gone.
#
# The site key comes from the reCAPTCHA v3 site you register at
# https://www.google.com/recaptcha/admin. Its counterpart *secret* goes into the
# Firebase console and nowhere else — never into this file.
#
# Public, like the keys above. Leave it blank and App Check is simply not
# initialised, which is how the app behaved before any of this existed.
#
# ONLY add your deployed domain to the reCAPTCHA allowed-domains list. Do NOT
# add localhost: the site key is public, so that would let anyone run this app
# against your project from their own machine. Use the debug token below.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional, and a real credential — it bypasses App Check entirely.
#
# reCAPTCHA will not vouch for localhost, and it cannot vouch for Node at all,
# so without this both `npm run dev` and the three harness scripts
# (`check-rules`, `sync-harness`, `host-room`) are refused the moment App Check
# enforcement is switched on.
#
# The value cannot be invented — it has to be one Google minted and you have
# safelisted. Two ways to get one:
#
#   1. Firebase console -> App Check -> Apps tab -> the three-dot menu on the
#      web app -> Manage debug tokens -> create. The dialog generates the value;
#      it will not accept one you typed. Copy it in here.
#
#   2. Set this to the literal `true`, run `npm run dev`, and the SDK prints a
#      token to the browser console. Safelist that on the same screen as above,
#      then replace `true` here with it.
#
# Revocable from that screen, which is the reason this is the supported route
# and adding localhost to the reCAPTCHA allowlist is not.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional, and only used by `npm run seed-vault`.
#
# Path to a service-account key: Project settings -> Service accounts ->
# Generate new private key. With it, seeding bypasses the security rules, so
# nothing has to be published and the game stays up while it runs. Without it,
# seeding falls back to anonymous auth and needs firestore.seed.rules published
# for the duration — see README step 4.
#
# Put the file under .secrets/, which is gitignored. It is a real credential:
# it can read and write the whole project.
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/service-account.json

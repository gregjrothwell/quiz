#!/bin/sh
# Typecheck, lint and the unit tests before a push leaves the machine, so a
# red one costs a minute here rather than a CI run (PROJ-93, Greg, 31 October
# 2026, docs/decisions/ci-speed.md). Installed by `npm install` / `npm ci`
# through the `prepare` script, which points core.hooksPath at .githooks.
#
# A push that changes only docs/ or Markdown skips it, as CI's Plan does.
# Anything this cannot classify — a new branch with no merge base, a remote
# commit not fetched here — runs the checks: guessing "docs only" wrongly is
# the expensive mistake. `SKIP_PREPUSH=1 git push` skips it outright.

[ -n "$SKIP_PREPUSH" ] && exit 0

zero=0000000000000000000000000000000000000000
run=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch being deleted
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/master 2>/dev/null) || base=''
  else
    base=$remote_sha
  fi
  if [ -z "$base" ]; then run=1; continue; fi
  if ! changed=$(git diff --name-only "$base" "$local_sha" 2>/dev/null); then run=1; continue; fi
  if printf '%s\n' "$changed" | grep -v -E '^$|^docs/|\.md$' >/dev/null; then run=1; fi
done

[ "$run" = 1 ] || exit 0

echo "pre-push: typecheck, lint, test (SKIP_PREPUSH=1 to skip)"
# Quiet when green: the suite's pack scripts print ~130 KB of progress. The
# output is kept and shown in full only when something fails.
log=$(mktemp "${TMPDIR:-/tmp}/quiz-pre-push.XXXXXX")
if npm run --silent typecheck >"$log" 2>&1 \
  && npm run --silent lint >>"$log" 2>&1 \
  && npx vitest run --silent --reporter=dot >>"$log" 2>&1; then
  rm -f "$log"
  echo "pre-push: green"
  exit 0
fi
grep -v -E '^ *(screen|sleeve|tune|clip) ' "$log" | tail -200 >&2
echo "pre-push: failed, so nothing was pushed. Full output: $log. SKIP_PREPUSH=1 overrides." >&2
exit 1
